# TMDB API key (v3). Server-only: never prefix it with NEXT_PUBLIC_.
TMDB_API_KEY=
# Optional, defaults to https://api.themoviedb.org/3
TMDB_BASE_URL=https://api.themoviedb.org/3
# Public URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (apps/api). Browser requests reach it through next.config rewrites.
API_URL=http://localhost:4000

# Public API URL for realtime (WebSocket) connections from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: public contact email shown on the privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: Cafecito username; shows the "buy me a coffee" button when set.
NEXT_PUBLIC_CAFECITO_USER=
# Optional: AdSense publisher id (ca-pub-...) and a display ad slot id. Ads, ads.txt
# and the consent banner stay off until both are set.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=
