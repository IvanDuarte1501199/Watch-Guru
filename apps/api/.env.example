PORT=4000
# Postgres from docker-compose.yml at the repo root
DATABASE_URL=postgres://watchguru:watchguru@localhost:5432/watchguru
# Public URL of the web app. Auth routes are served through its /api/auth rewrite.
WEB_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# TMDB v3 key, used for personalized recommendations
TMDB_API_KEY=
# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {WEB_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: transactional email (password reset, email verification) via https://resend.com
# Without it, emails are printed to the API console.
RESEND_API_KEY=
EMAIL_FROM=WatchGuru <onboarding@resend.dev>
